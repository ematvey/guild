{
  "name": "@guild/server",
  "private": true,
  "version": "0.6.82",
  "type": "module",
  "description": "Guild cloud server (TypeScript, on pi-durable).",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
