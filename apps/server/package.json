    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@earendil-works/chord": "1.5.0",
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-codemode": "1.5.0",
    "@earendil-works/pi-durable": "1.5.0",
    "@fastify/http-proxy": "^11.6.3",
    "@fastify/websocket": "^11.3.3",
    "@guild/genui": "file:../../packages/genui",
    "@guild/integration-sdk": "file:../../packages/integration-sdk",
    "@guild/wire": "file:../../packages/wire",
    "@node-rs/argon2": "^2.2.1",
    "croner": "^10.0.1",
    "fastify": "^5.6.3",
    "pg": "^8.19.0",
    "pino": "^10.2.0",
    "tar": "^7.5.22",
    "typebox": "1.3.27",
    "web-push": "^3.6.7",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.4",
    "@types/pg": "^8.19.0",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.2",
    "tsx": "^4.21.0",
