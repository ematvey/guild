# Copy to `config.env` next to this file and adjust.

# Bind address inside the server container (the TS server is the only
# server; it publishes ${GUILD_HTTP_PORT} -> 8080).
GUILD_BIND_ADDR=0.0.0.0:8080

# Default mode: shared HOST services (see docs/deploy-nuances.md §Host services).
# Postgres: host service, published on :5432
GUILD_DATABASE_URL=postgres://guild:guild@host.docker.internal:5432/guild

# ClickHouse: host service, published on :8123
GUILD_CLICKHOUSE_URL=http://host.docker.internal:8123
GUILD_CLICKHOUSE_DATABASE=guild
GUILD_CLICKHOUSE_USER=
GUILD_CLICKHOUSE_PASSWORD=

# 64 hex chars = 32 bytes. Generate with: openssl rand -hex 32
# The server refuses the placeholder in production.
GUILD_MASTER_KEY_HEX=REPLACE_WITH_OPENSSL_RAND_HEX_32

# Any long random string. Generate with: openssl rand -hex 32
GUILD_JWT_SECRET=REPLACE_WITH_OPENSSL_RAND_HEX_32

# GUILD_API_URL is the API base other components call back to (OIDC,
# releases links, updater download URLs) — the TS server container itself.
GUILD_API_URL=http://server:8080
# Internal key the agent harness uses for loopback gateway calls (never
# public; generate with: openssl rand -hex 32). Required: the durable
# harness runs in this server.
GUILD_INTERNAL_KEY=REPLACE_WITH_OPENSSL_RAND_HEX_32

# Server-side workspace sessions (execution backend, M6)
GUILD_DATA_DIR=/data

# Agent workspaces (JuiceFS-backed). The server binds the volume read-only
# at /workspaces for the file browser; the runner binds it read-write.
# GUILD_AGENT_WORKSPACE_ROOT=/workspaces

# JuiceFS sidecar. Defaults live in deploy/juicefs/entrypoint.sh; set any
# of these to override. The metadata database is created by the one-shot
# juicefs-init service from GUILD_DATABASE_URL credentials.
# GUILD_JUICE_META_URL=postgres://guild:guild@host.docker.internal:5432/guild_meta
# GUILD_JUICE_META_DB=guild_meta
# GUILD_JUICE_VOLUME=guild
# GUILD_JUICE_BUCKET=guild-workspaces
# GUILD_JUICE_S3_URL=http://host.docker.internal:9950
# GUILD_JUICE_STORAGE=s3
# GUILD_JUICE_ACCESS_KEY=guild
# GUILD_JUICE_SECRET_KEY=<see config.env>
# Host directory the sidecar mounts into (the guild_workspaces bind source).
# Must exist before `docker compose up`: mkdir -p /mnt/guild
# GUILD_WORKSPACE_HOST_DIR=/mnt/guild

# Server-side tool sandboxes (gVisor via the sandbox-runner service).
# Shared secret between the server and the runner (generate with:
# openssl rand -hex 32). The host Docker daemon needs the `runsc` runtime —
# see docs/deploy-nuances.md §Sandboxes. Shell tools default to on with a
# runner; set GUILD_ALLOW_SHELL_TOOLS=0 to keep them off.
GUILD_SANDBOX_RUNNER_TOKEN=REPLACE_WITH_OPENSSL_RAND_HEX_32
# Runner knobs (defaults shown):
# GUILD_SANDBOX_NETWORK_MODE=proxied        # or none (no egress at all)
# GUILD_SANDBOX_MEMORY_MB=2048
# GUILD_SANDBOX_CPUS=2
# GUILD_SANDBOX_IDLE_STOP_SECONDS=900
# GUILD_SANDBOX_IDLE_REMOVE_SECONDS=86400
# GUILD_SANDBOX_MAX_RUNNING=32
# Hosts without gVisor (development only):
# GUILD_SANDBOX_RUNTIME=runc
# GUILD_SANDBOX_ALLOW_RUNC=1

# M6: browser telemetry (/faro/collect) forwards to this Faro receiver.
# Empty disables the endpoint (responses are always 202).
GUILD_FARO_URL=http://host.docker.internal:12347/collect

# M6: the chat SPA is built into the guild-server-ts image (Dockerfile
# stage `webui`) and served from apps/desktop/dist. Override only for
# development (a host-built dist); leave unset in compose.
# GUILD_WEB_DIST=/app/apps/desktop/dist

# M6: optional ed25519 seed (64 hex chars) for release-artifact signatures.
# Leave unset: the server auto-generates and persists one in server_kv on
# first upload (GUILD_API_URL shapes the updater download URLs, so keep it
# stable — it is http://server:8080 above).
# GUILD_RELEASE_SIGNING_SEED=

# Object storage: neutral host rustfs (published :9950); holds registry bundles.
GUILD_S3_URL=http://host.docker.internal:9950
GUILD_S3_BUCKET=guild
GUILD_S3_ACCESS_KEY_ID=guild
GUILD_S3_SECRET_ACCESS_KEY=<see config.env>

# Prod stacks that share this host set GUILD_TS_SERVER_IMAGE (e.g.
# guild-server-ts:prod) so a second compose project can't clobber the
# shared guild-server-ts:latest tag — same pattern as GUILD_SERVER_IMAGE.
# GUILD_TS_SERVER_IMAGE=guild-server-ts:prod
# GUILD_SANDBOX_IMAGE=guild-sandbox:prod
# GUILD_SANDBOX_EGRESS_IMAGE=guild-sandbox-egress:prod

# Integration plugin catalog every org starts with (an index.json URL in the
# guild-plugin-catalog/1 format). Unset = orgs start with no catalog; admins
# add their own under Settings → Integrations → Catalogs.
# GUILD_DEFAULT_PLUGIN_CATALOG=https://example.github.io/guild-plugins/index.json
