# JuiceFS sidecar settings that only the juicefs service reads (copy to
# juicefs.env). The server, the runner and the sandboxes never see them.
#
# Object-store key for the workspace bucket. Prefer a key scoped to that one
# bucket; without these the sidecar falls back to config.env's GUILD_S3_*.
# GUILD_JUICE_ACCESS_KEY=guild-workspaces-dev
# GUILD_JUICE_SECRET_KEY=<secret>
#
# Optional overrides (defaults: config.env's GUILD_S3_URL, s3, and a metadata
# URL built from GUILD_DATABASE_URL with GUILD_JUICE_META_DB).
# GUILD_JUICE_S3_URL=http://host.docker.internal:9950
# GUILD_JUICE_STORAGE=s3
# GUILD_JUICE_META_URL=postgres://guild:guild@host.docker.internal:5432/guild_meta_dev
