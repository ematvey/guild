# TS server (apps/server) image — the Fastify app serving the full public
# surface (health, auth, chats/turns on pi-durable, hub WS, gateway,
# registry, releases, projects, teams, admin, integrations, faro, web UI).
# Runtime is Bun executing the TS sources directly — no tsc dist, no
# compile of the server itself. The chat SPA is built in a `webui` stage
# and served from apps/desktop/dist (GUILD_WEB_DIST default; see
# apps/server/src/platform/http/web.ts).

# Build stage: npm workspaces install (root package.json/lockfile).
FROM node:22 AS build
WORKDIR /app
# @openuidev/lang-core's postinstall reports the install to its vendor
# unless this is set.
ENV OPENUI_TELEMETRY_DISABLED=1
COPY package.json package-lock.json ./
# npm ci validates every workspace listed in the root package.json.
COPY apps/desktop/package.json apps/desktop/
COPY apps/control-center/package.json apps/control-center/
COPY apps/server/package.json apps/server/
COPY packages/ui/package.json packages/ui/
COPY packages/wire/package.json packages/wire/
COPY packages/genui/package.json packages/genui/
COPY packages/integration-sdk/package.json packages/integration-sdk/
COPY packages/integration-sdk/bin packages/integration-sdk/bin
RUN npm ci --workspace apps/server --no-audit --no-fund
COPY packages/wire/src ./packages/wire/src
COPY packages/genui/src ./packages/genui/src
COPY packages/integration-sdk/src ./packages/integration-sdk/src
# The static exec-policy rules: the TS matcher loads the shared rule set
# from apps/server/assets (relocated out of the Rust tree ahead of its
# deletion).
COPY apps/server/assets/exec_policy_base.rules apps/server/assets/exec_policy_base.rules
# The platform SQL migrations: applied at startup (schema_history-tracked).
COPY apps/server/migrations ./apps/server/migrations

# Frontend stage: build the chat SPA (apps/desktop) for the TS server to
# serve at /. Needs the shared UI kit and the wire types.
FROM node:22 AS webui
WORKDIR /app
ENV OPENUI_TELEMETRY_DISABLED=1
COPY package.json package-lock.json ./
COPY apps/desktop/package.json apps/desktop/
COPY apps/control-center/package.json apps/control-center/
COPY packages/ui/package.json packages/ui/
COPY packages/wire/package.json packages/wire/
COPY packages/genui/package.json packages/genui/
COPY packages/integration-sdk/package.json packages/integration-sdk/
COPY packages/integration-sdk/bin packages/integration-sdk/bin
RUN npm ci --workspace apps/desktop --workspace apps/control-center --no-audit --no-fund
COPY packages/ui/src ./packages/ui/src
COPY packages/wire/src ./packages/wire/src
COPY packages/genui/src ./packages/genui/src
COPY apps/desktop/index.html apps/desktop/vite.config.ts apps/desktop/tsconfig.json apps/desktop/
COPY apps/desktop/src ./apps/desktop/src
COPY apps/desktop/public ./apps/desktop/public
COPY apps/control-center/index.html apps/control-center/tsconfig.json apps/control-center/vite.config.ts ./apps/control-center/
COPY apps/control-center/src ./apps/control-center/src
RUN npm run build --workspace apps/desktop
RUN npm run build:control

# Runtime stage: Bun executes the TS sources directly (no server compile);
# production deps (hoisted into /app/node_modules) + the sources.
FROM node:22-slim
COPY --from=oven/bun:1 /usr/local/bin/bun /usr/local/bin/bun
WORKDIR /app
ENV NODE_ENV=production
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/apps/server/package.json ./apps/server/package.json
# Build stamps are baked into the image; runtime environment cannot lift the
# client-update ceiling independently of the deployed server artifact.
ARG GUILD_BUILD_VERSION
ARG GUILD_BUILD_COMMIT
RUN node -e '\
  const fs = require("node:fs"); \
  const [version, commit] = process.argv.slice(1); \
  const file = "apps/server/package.json"; \
  const manifest = JSON.parse(fs.readFileSync(file)); \
  if (version && !/^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)(-dev\.[1-9][0-9]*)?$/.test(version)) throw new Error("invalid server build version"); \
  if (commit && !/^[a-f0-9]{40}$/.test(commit)) throw new Error("invalid server build commit"); \
  if (version) manifest.version = version; \
  if (commit) manifest.guildBuildCommit = commit; \
  fs.writeFileSync(file, JSON.stringify(manifest));' "$GUILD_BUILD_VERSION" "$GUILD_BUILD_COMMIT"
# The server sources Bun runs.
COPY apps/server/src ./apps/server/src
# The @guild/wire package the server imports resolve through node_modules:
# the workspace symlink points here, so the package must exist at runtime too.
COPY --from=build /app/packages/wire ./packages/wire
COPY --from=build /app/packages/genui ./packages/genui
COPY --from=build /app/packages/integration-sdk ./packages/integration-sdk
# The chat SPA: GUILD_WEB_DIST's default (../desktop/dist from the server
# cwd) resolves here.
COPY --from=webui /app/apps/desktop/dist ./apps/desktop/dist
COPY --from=webui /app/apps/control-center/dist ./apps/control-center/dist
# The static exec-policy rules (M4, relocated 2026-10-04 to apps/server/assets
# ahead of the Rust tree's deletion): the matcher loads the SAME rule set —
# no TS fork. The default path resolves relative to the server's cwd:
# <cwd>/assets/.
COPY --from=build /app/apps/server/assets/exec_policy_base.rules /app/apps/server/assets/exec_policy_base.rules
# The platform SQL migrations: startup applies pending files in filename
# order (platform/migrations.ts, schema_history-tracked).
COPY --from=build /app/apps/server/migrations /app/apps/server/migrations
WORKDIR /app/apps/server
# Non-root: model-driven tools never run in this process (they run in
# sandbox containers via the sandbox runner), but the server still must not
# be root. uid 1000 (`node`) matches the sandbox uid, so both sides of the
# shared /data volume agree on ownership. The sandbox runner reuses this
# image as root (it needs the Docker socket) with its own command.
RUN mkdir -p /data && chown node:node /data
USER node
EXPOSE 8080
CMD ["bun", "src/index.ts"]
