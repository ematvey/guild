{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://guild.local/protocol/socket.schema.json",
  "title": "Guild member socket",
  "description": "The frame vocabulary of the member and machine socket. This schema is the contract: crates/protocol/src/ws.rs (Rust) and packages/wire/src/types.ts (TypeScript) are hand-written from it and tested against protocol/fixtures. Every frame is a JSON object tagged by `type`; the tag is a `const` in each variant, so `oneOf` discriminates. `additionalProperties: false` is deliberate: a new field is a contract change, not a client surprise. Absent means the sender omitted the key; `null` means the sender sent a JSON null. The two are not interchangeable. A row type that also crosses the REST surface is referenced by the REST schema's `$id`, never copied here. The root is an index of the definitions: validate a payload against a `$defs` entry, never against the root.",
  "type": "object",
  "properties": {
    "Uuid": { "$ref": "#/$defs/Uuid" },
    "Json": { "$ref": "#/$defs/Json" },
    "ServerFrame": { "$ref": "#/$defs/ServerFrame" },
    "ClientFrame": { "$ref": "#/$defs/ClientFrame" },
    "Hello": { "$ref": "#/$defs/Hello" },
    "Displaced": { "$ref": "#/$defs/Displaced" },
    "AuthRequired": { "$ref": "#/$defs/AuthRequired" },
    "Pong": { "$ref": "#/$defs/Pong" },
    "Ping": { "$ref": "#/$defs/Ping" },
    "ToolDispatch": { "$ref": "#/$defs/ToolDispatch" },
    "ToolCancel": { "$ref": "#/$defs/ToolCancel" },
    "ErrorFrame": { "$ref": "#/$defs/ErrorFrame" },
    "MachineRequest": { "$ref": "#/$defs/MachineRequest" },
    "ThreadList": { "$ref": "#/$defs/ThreadList" },
    "ChatStatus": { "$ref": "#/$defs/ChatStatus" },
    "ThreadEvents": { "$ref": "#/$defs/ThreadEvents" },
    "SyncBegin": { "$ref": "#/$defs/SyncBegin" },
    "SyncDone": { "$ref": "#/$defs/SyncDone" },
    "ThreadState": { "$ref": "#/$defs/ThreadState" },
    "QueuedInput": { "$ref": "#/$defs/QueuedInput" },
    "LiveFrame": { "$ref": "#/$defs/LiveFrame" },
    "OrgEvent": { "$ref": "#/$defs/OrgEvent" },
    "SubagentTree": { "$ref": "#/$defs/SubagentTree" },
    "MachineStatus": { "$ref": "#/$defs/MachineStatus" },
    "ArchivedThreadList": { "$ref": "#/$defs/ArchivedThreadList" },
    "ProjectList": { "$ref": "#/$defs/ProjectList" },
    "MachineList": { "$ref": "#/$defs/MachineList" },
    "WorkspaceIdentity": { "$ref": "#/$defs/WorkspaceIdentity" },
    "ModelList": { "$ref": "#/$defs/ModelList" },
    "MemberProfile": { "$ref": "#/$defs/MemberProfile" },
    "ModelOption": { "$ref": "#/$defs/ModelOption" },
    "AgentList": { "$ref": "#/$defs/AgentList" },
    "IntegrationAccess": { "$ref": "#/$defs/IntegrationAccess" },
    "AgentRunFrame": { "$ref": "#/$defs/AgentRunFrame" },
    "AgentThreads": { "$ref": "#/$defs/AgentThreads" },
    "AgentRoutines": { "$ref": "#/$defs/AgentRoutines" },
    "SkillCatalog": { "$ref": "#/$defs/SkillCatalog" },
    "ChatTreeFrame": { "$ref": "#/$defs/ChatTreeFrame" },
    "ChatRow": { "$ref": "#/$defs/ChatRow" },
    "ContextUsage": { "$ref": "#/$defs/ContextUsage" },
    "Sync": { "$ref": "#/$defs/Sync" },
    "Read": { "$ref": "#/$defs/Read" },
    "MachineResponse": { "$ref": "#/$defs/MachineResponse" },
    "ToolResult": { "$ref": "#/$defs/ToolResult" },
    "StreamEvent": { "$ref": "#/$defs/StreamEvent" },
    "StreamDelta": { "$ref": "#/$defs/StreamDelta" },
    "StreamThinkingDelta": { "$ref": "#/$defs/StreamThinkingDelta" },
    "StreamIdle": { "$ref": "#/$defs/StreamIdle" },
    "StreamDone": { "$ref": "#/$defs/StreamDone" },
    "StreamError": { "$ref": "#/$defs/StreamError" },
    "StreamToolCallDelta": { "$ref": "#/$defs/StreamToolCallDelta" },
    "StreamToolCallDone": { "$ref": "#/$defs/StreamToolCallDone" },
    "StreamToolStarted": { "$ref": "#/$defs/StreamToolStarted" },
    "StreamToolCompleted": { "$ref": "#/$defs/StreamToolCompleted" },
    "StreamApprovalRequested": { "$ref": "#/$defs/StreamApprovalRequested" },
    "StreamApprovalResolved": { "$ref": "#/$defs/StreamApprovalResolved" }
  },
  "additionalProperties": false,
  "$defs": {
    "Uuid": { "type": "string", "format": "uuid" },
    "Json": {},

    "ServerFrame": {
      "oneOf": [
        { "$ref": "#/$defs/Hello" },
        { "$ref": "#/$defs/Displaced" },
        { "$ref": "#/$defs/AuthRequired" },
        { "$ref": "#/$defs/ToolDispatch" },
        { "$ref": "#/$defs/ToolCancel" },
        { "$ref": "#/$defs/ErrorFrame" },
        { "$ref": "#/$defs/MachineRequest" },
        { "$ref": "#/$defs/ThreadList" },
        { "$ref": "#/$defs/ChatStatus" },
        { "$ref": "#/$defs/ThreadEvents" },
        { "$ref": "#/$defs/SyncBegin" },
        { "$ref": "#/$defs/ThreadState" },
        { "$ref": "#/$defs/SyncDone" },
        { "$ref": "#/$defs/Pong" },
        { "$ref": "#/$defs/LiveFrame" },
        { "$ref": "#/$defs/OrgEvent" },
        { "$ref": "#/$defs/SubagentTree" },
        { "$ref": "#/$defs/MachineStatus" },
        { "$ref": "#/$defs/ArchivedThreadList" },
        { "$ref": "#/$defs/ProjectList" },
        { "$ref": "#/$defs/MachineList" },
        { "$ref": "#/$defs/WorkspaceIdentity" },
        { "$ref": "#/$defs/ModelList" },
        { "$ref": "#/$defs/MemberProfile" },
        { "$ref": "#/$defs/AgentList" },
        { "$ref": "#/$defs/IntegrationAccess" },
        { "$ref": "#/$defs/AgentRunFrame" },
        { "$ref": "#/$defs/AgentThreads" },
        { "$ref": "#/$defs/AgentRoutines" },
        { "$ref": "#/$defs/SkillCatalog" },
        { "$ref": "#/$defs/ChatTreeFrame" },
        { "$ref": "#/$defs/ChatRow" },
        { "$ref": "#/$defs/ContextUsage" }
      ]
    },

    "ClientFrame": {
      "oneOf": [
        { "$ref": "#/$defs/Ping" },
        { "$ref": "#/$defs/Sync" },
        { "$ref": "#/$defs/Read" },
        { "$ref": "#/$defs/MachineResponse" },
        { "$ref": "#/$defs/ToolResult" }
      ]
    },

    "Hello": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": { "type": { "const": "hello" } }
    },
    "Displaced": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": { "type": { "const": "displaced" } }
    },
    "AuthRequired": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": { "type": { "const": "auth_required" } }
    },
    "Pong": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": { "type": { "const": "pong" } }
    },
    "Ping": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": { "type": { "const": "ping" } }
    },

    "ToolDispatch": {
      "type": "object",
      "required": ["type", "chat_id", "call_id", "name", "arguments"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "tool_dispatch" },
        "chat_id": { "$ref": "#/$defs/Uuid" },
        "call_id": { "type": "string" },
        "name": { "type": "string" },
        "arguments": { "type": "string" },
        "workdir": {
          "type": "string",
          "description": "The workspace folder to run in. Absent means no workspace."
        }
      }
    },
    "ToolCancel": {
      "type": "object",
      "required": ["type", "call_id"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "tool_cancel" },
        "call_id": { "type": "string" }
      }
    },
    "ErrorFrame": {
      "type": "object",
      "required": ["type", "message"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "error" },
        "message": { "type": "string" }
      }
    },
    "MachineRequest": {
      "type": "object",
      "required": ["type", "request_id", "op", "payload"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "machine_request" },
        "request_id": { "type": "string" },
        "op": { "type": "string" },
        "payload": { "$ref": "#/$defs/Json" }
      }
    },
    "ThreadList": {
      "type": "object",
      "required": ["type", "chats"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "thread_list" },
        "chats": { "type": "array", "items": { "$ref": "https://guild.local/protocol/rest.schema.json#/$defs/Chat" } }
      }
    },
    "ChatStatus": {
      "type": "object",
      "required": ["type", "chat_id", "generating"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "chat_status" },
        "chat_id": { "$ref": "#/$defs/Uuid" },
        "generating": { "type": "boolean" }
      }
    },
    "ThreadEvents": {
      "type": "object",
      "required": ["type", "chat_id", "seq", "events"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "thread_events" },
        "chat_id": { "$ref": "#/$defs/Uuid" },
        "seq": {
          "type": "integer",
          "description": "The newest `seq` carried by `events`; the client watermark guard."
        },
        "events": { "type": "array", "items": { "$ref": "https://guild.local/protocol/rest.schema.json#/$defs/ThreadEventRow" } }
      }
    },
    "SyncBegin": {
      "type": "object",
      "required": ["type", "chat_id"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "sync_begin" },
        "chat_id": { "$ref": "#/$defs/Uuid" }
      }
    },
    "SyncDone": {
      "type": "object",
      "required": ["type", "chat_id"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "sync_done" },
        "chat_id": { "$ref": "#/$defs/Uuid" }
      }
    },
    "ThreadState": {
      "type": "object",
      "required": ["type", "chat_id", "seq", "events", "text", "thinking", "generating", "has_more_events"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "thread_state" },
        "chat_id": { "$ref": "#/$defs/Uuid" },
        "seq": { "type": "integer" },
        "events": { "type": "array", "items": { "$ref": "https://guild.local/protocol/rest.schema.json#/$defs/ThreadEventRow" } },
        "text": { "type": "string" },
        "thinking": { "type": "string" },
        "generating": { "type": "boolean" },
        "project_id": { "$ref": "#/$defs/Uuid" },
        "project_name": { "type": "string" },
        "project_machine_label": { "type": "string" },
        "has_more_events": {
          "type": "boolean",
          "description": "Always serialized. True when `events` is only the newest page of the durable log."
        },
        "compacting": {
          "type": "boolean",
          "description": "True while a compaction of the chat's context is running. Absent from servers that do not report it."
        },
        "queue": {
          "type": "array",
          "items": { "$ref": "#/$defs/QueuedInput" },
          "description": "The chat's inputs waiting for the agent, in the order it takes them. A row appears in `events` only once its input is taken. Absent from servers that do not report it."
        }
      }
    },
    "QueuedInput": {
      "type": "object",
      "required": ["id", "kind", "mode", "text", "attachments"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "description": "A member message's message id (the id its thread row takes once placed); `submission:<n>` for any other input."
        },
        "kind": {
          "enum": ["message", "turn", "child_result"],
          "description": "message: a member's message; turn: a turn posted by an agent or routine; child_result: a child thread's result."
        },
        "mode": { "enum": ["steer", "queue"] },
        "text": { "type": "string" },
        "attachments": {
          "type": "array",
          "items": { "$ref": "https://guild.local/protocol/rest.schema.json#/$defs/MessageAttachment" }
        }
      }
    },
    "LiveFrame": {
      "type": "object",
      "required": ["type", "chat_id", "generation_id", "seq", "machine_id", "event"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "live_frame" },
        "chat_id": { "$ref": "#/$defs/Uuid" },
        "generation_id": { "$ref": "#/$defs/Uuid" },
        "seq": { "type": "integer" },
        "machine_id": {
          "type": ["string", "null"],
          "description": "Always serialized. null means the frame carries no machine."
        },
        "event": { "$ref": "#/$defs/StreamEvent" }
      }
    },
    "OrgEvent": {
      "type": "object",
      "required": ["type", "event"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "org_event" },
        "event": { "$ref": "https://guild.local/protocol/rest.schema.json#/$defs/EventRow" }
      }
    },
    "SubagentTree": {
      "type": "object",
      "required": ["type", "chat_id", "nodes"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "subagent_tree" },
        "chat_id": { "$ref": "#/$defs/Uuid" },
        "nodes": { "type": "array", "items": { "$ref": "https://guild.local/protocol/rest.schema.json#/$defs/SubagentNode" } }
      }
    },
    "MachineStatus": {
      "type": "object",
      "required": ["type", "machine_id", "online"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "machine_status" },
        "machine_id": { "type": "string" },
        "online": { "type": "boolean" }
      }
    },
    "ArchivedThreadList": {
      "type": "object",
      "required": ["type", "chats"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "archived_thread_list" },
        "chats": { "type": "array", "items": { "$ref": "https://guild.local/protocol/rest.schema.json#/$defs/Chat" } }
      }
    },
    "ProjectList": {
      "type": "object",
      "required": ["type", "projects", "archived_projects"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "project_list" },
        "projects": {
          "type": "array",
          "items": { "$ref": "https://guild.local/protocol/rest.schema.json#/$defs/Project" }
        },
        "archived_projects": {
          "type": "array",
          "items": { "$ref": "https://guild.local/protocol/rest.schema.json#/$defs/Project" }
        }
      }
    },
    "MachineList": {
      "type": "object",
      "required": ["type", "machines"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "machine_list" },
        "machines": {
          "type": "array",
          "items": { "$ref": "https://guild.local/protocol/rest.schema.json#/$defs/MachineInfo" }
        }
      }
    },
    "WorkspaceIdentity": {
      "type": "object",
      "required": ["type", "name", "telemetry"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "workspace_identity" },
        "name": { "type": "string" },
        "logo_url": { "type": "string" },
        "telemetry": {
          "type": "boolean",
          "description": "Admin-controlled telemetry switch: when true the client collects app diagnostics and sends them to the workspace collector."
        },
        "web_bundle": {
          "type": "string",
          "description": "Identity of the web bundle the server serves (its entry script hash). A browser client running a different bundle reloads into the served one. Absent when the server serves no bundle."
        }
      }
    },
    "ModelList": {
      "type": "object",
      "required": ["type", "models"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "model_list" },
        "models": {
          "type": "array",
          "description": "The org's enabled chat models, ordered by id. Sent with every workspace push and to every member socket of the org when an admin changes a route.",
          "items": { "$ref": "#/$defs/ModelOption" }
        }
      }
    },
    "MemberProfile": {
      "type": "object",
      "required": ["type", "user"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "member_profile" },
        "user": {
          "$ref": "https://guild.local/protocol/rest.schema.json#/$defs/UserInfo",
          "description": "The member's own account. Sent with every workspace push and whenever its role, name, avatar or onboarding flag changes."
        }
      }
    },
    "ModelOption": {
      "type": "object",
      "required": ["id", "alias"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "alias": {
          "type": "string",
          "description": "The admin's display name; empty when the route is unnamed."
        },
        "context_window": {
          "type": "integer",
          "minimum": 1,
          "description": "The model's context window in tokens (the route's setting, else the server default): the denominator of the composer's context meter. Absent from servers that do not report it."
        }
      }
    },
    "AgentList": {
      "description": "Every agent the caller may see, archived and deleting ones included. Sent on connect and to every member of the org when an agent, a grant or a team membership changes; each member receives their own visibility-filtered list.",
      "type": "object",
      "required": ["type", "agents"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "agent_list" },
        "agents": {
          "type": "array",
          "items": { "$ref": "https://guild.local/protocol/rest.schema.json#/$defs/Agent" }
        }
      }
    },
    "IntegrationAccess": {
      "description": "The Integrations the member may add to an agent they manage, each with the highest class they may give. Sent on connect and to every member of the org when an Integration's audience, its team grants, its enabled flag or a team membership changes.",
      "type": "object",
      "required": ["type", "integrations"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "integration_access" },
        "integrations": {
          "type": "array",
          "items": { "$ref": "https://guild.local/protocol/rest.schema.json#/$defs/AttachableIntegration" }
        }
      }
    },
    "AgentRunFrame": {
      "description": "One run, created or changed. Sent to every member who may see the run's agent; the client upserts it by id into each list that shows it.",
      "type": "object",
      "required": ["type", "run"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "agent_run" },
        "run": { "$ref": "https://guild.local/protocol/rest.schema.json#/$defs/AgentRun" }
      }
    },
    "AgentThreads": {
      "description": "The caller's open user threads with one agent, newest activity first: the same page GET /api/v1/agents/:id/threads returns. Sent to the threads' owner when one of them changes.",
      "type": "object",
      "required": ["type", "agent_id", "threads"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "agent_threads" },
        "agent_id": { "$ref": "#/$defs/Uuid" },
        "threads": {
          "type": "array",
          "items": { "$ref": "https://guild.local/protocol/rest.schema.json#/$defs/AgentThread" }
        }
      }
    },
    "AgentRoutines": {
      "description": "One agent's routines with their newest runs. Sent to every member who may see the agent when a routine is created, changed, scheduled or deleted.",
      "type": "object",
      "required": ["type", "agent_id", "routines"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "agent_routines" },
        "agent_id": { "$ref": "#/$defs/Uuid" },
        "routines": {
          "type": "array",
          "items": { "$ref": "https://guild.local/protocol/rest.schema.json#/$defs/AgentRoutine" }
        }
      }
    },
    "SkillCatalog": {
      "description": "The org skill catalog plus the caller's own installs. Sent on connect and to every member of the org when a skill is published, gated, unpublished, installed, uninstalled or pinned.",
      "type": "object",
      "required": ["type", "items", "installs"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "skill_catalog" },
        "items": {
          "type": "array",
          "items": { "$ref": "https://guild.local/protocol/rest.schema.json#/$defs/SkillCatalogItem" }
        },
        "installs": {
          "type": "array",
          "items": { "$ref": "https://guild.local/protocol/rest.schema.json#/$defs/SkillInstall" }
        }
      }
    },
    "ChatTreeFrame": {
      "description": "One chat's tree facts for its header. Sent inside the chat's sync bracket and to the chat owner's sockets whenever its title, run status, parent title or flags change.",
      "type": "object",
      "required": ["type", "chat_id", "tree"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "chat_tree" },
        "chat_id": { "$ref": "#/$defs/Uuid" },
        "tree": { "$ref": "https://guild.local/protocol/rest.schema.json#/$defs/ChatTree" }
      }
    },
    "ChatRow": {
      "description": "One row of the caller's active chat list changed while the list kept its rows and order: the client replaces that row by id. Sent instead of a whole thread_list, and only to sockets that connected with `features=chat_row`; any other list change sends thread_list.",
      "type": "object",
      "required": ["type", "chat"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "chat_row" },
        "chat": { "$ref": "https://guild.local/protocol/rest.schema.json#/$defs/Chat" }
      }
    },
    "ContextUsage": {
      "description": "One chat's context usage: the prompt-plus-response tokens of its last completed model request since the last compaction, and the model that request ran on. Sent inside the chat's sync bracket and to the chat owner's sockets when it changes (a turn ends, a compaction lands). The meter's denominator is the selected model's `ModelOption.context_window`.",
      "type": "object",
      "required": ["type", "chat_id", "tokens", "usage_model", "usage_model_alias"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "context_usage" },
        "chat_id": { "$ref": "#/$defs/Uuid" },
        "tokens": { "type": ["integer", "null"], "description": "Null when no completed request is measured yet." },
        "usage_model": { "type": ["string", "null"], "description": "The model the measured request ran on." },
        "usage_model_alias": { "type": ["string", "null"], "description": "Display name of `usage_model`; null when that route is gone or unnamed." }
      }
    },

    "Sync": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "sync" },
        "chat_id": {
          "type": ["string", "null"],
          "description": "Optional. Omitted or null means no chat is open."
        }
      }
    },
    "Read": {
      "type": "object",
      "required": ["type", "chat_id"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "read" },
        "chat_id": { "$ref": "#/$defs/Uuid" }
      }
    },
    "MachineResponse": {
      "type": "object",
      "required": ["type", "request_id", "ok"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "machine_response" },
        "request_id": { "type": "string" },
        "ok": { "type": "boolean" },
        "payload": { "$ref": "#/$defs/Json" },
        "error": { "type": "string" }
      }
    },
    "ToolResult": {
      "type": "object",
      "required": ["type", "chat_id", "call_id", "content", "is_error"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "tool_result" },
        "chat_id": { "$ref": "#/$defs/Uuid" },
        "call_id": { "type": "string" },
        "content": { "type": "string" },
        "is_error": { "type": "boolean" },
        "meta": {
          "description": "Optional. Omitted or null means the tool reported no metadata.",
          "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/Json" }]
        },
        "images": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Omitted when empty."
        }
      }
    },

    "StreamEvent": {
      "oneOf": [
        { "$ref": "#/$defs/StreamDelta" },
        { "$ref": "#/$defs/StreamIdle" },
        { "$ref": "#/$defs/StreamDone" },
        { "$ref": "#/$defs/StreamError" },
        { "$ref": "#/$defs/StreamToolCallDelta" },
        { "$ref": "#/$defs/StreamToolCallDone" },
        { "$ref": "#/$defs/StreamToolStarted" },
        { "$ref": "#/$defs/StreamToolCompleted" },
        { "$ref": "#/$defs/StreamApprovalRequested" },
        { "$ref": "#/$defs/StreamApprovalResolved" },
        { "$ref": "#/$defs/StreamThinkingDelta" }
      ]
    },
    "StreamDelta": {
      "type": "object",
      "required": ["type", "content"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "delta" },
        "content": { "type": "string" }
      }
    },
    "StreamThinkingDelta": {
      "type": "object",
      "required": ["type", "content"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "thinking_delta" },
        "content": { "type": "string" }
      }
    },
    "StreamIdle": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": { "type": { "const": "idle" } }
    },
    "StreamDone": {
      "type": "object",
      "required": ["type", "message_id", "cost_usd", "tokens_in", "tokens_out"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "done" },
        "message_id": { "$ref": "#/$defs/Uuid" },
        "cost_usd": { "type": "number" },
        "tokens_in": { "type": "integer", "minimum": 0 },
        "tokens_out": { "type": "integer", "minimum": 0 }
      }
    },
    "StreamError": {
      "type": "object",
      "required": ["type", "code", "message"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "error" },
        "code": { "type": "string" },
        "message": { "type": "string" }
      }
    },
    "StreamToolCallDelta": {
      "type": "object",
      "required": ["type", "index", "arguments_delta"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "tool_call_delta" },
        "index": { "type": "integer", "minimum": 0 },
        "id": { "type": "string" },
        "name": { "type": "string" },
        "arguments_delta": { "type": "string" }
      }
    },
    "StreamToolCallDone": {
      "type": "object",
      "required": ["type", "call"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "tool_call_done" },
        "call": { "$ref": "https://guild.local/protocol/rest.schema.json#/$defs/ToolCall" }
      }
    },
    "StreamToolStarted": {
      "type": "object",
      "required": ["type", "call_id", "name", "arguments", "executor"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "tool_started" },
        "call_id": { "type": "string" },
        "name": { "type": "string" },
        "arguments": { "type": "string" },
        "executor": { "enum": ["client", "server"] },
        "kind": { "enum": ["web_search", "web_browse", "generic"] }
      }
    },
    "StreamToolCompleted": {
      "type": "object",
      "required": ["type", "call_id", "name", "content", "is_error"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "tool_completed" },
        "call_id": { "type": "string" },
        "name": { "type": "string" },
        "content": { "type": "string" },
        "is_error": { "type": "boolean" }
      }
    },
    "StreamApprovalRequested": {
      "type": "object",
      "required": ["type", "call_id", "name", "arguments"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "approval_requested" },
        "call_id": { "type": "string" },
        "name": { "type": "string" },
        "arguments": { "type": "string" }
      }
    },
    "StreamApprovalResolved": {
      "type": "object",
      "required": ["type", "call_id", "approved"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "approval_resolved" },
        "call_id": { "type": "string" },
        "approved": { "type": "boolean" },
        "reason": { "type": "string" }
      }
    }
  }
}
